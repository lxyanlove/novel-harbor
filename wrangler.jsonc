{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novel-harbor",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "vars": {"ALLOWED_HOSTS": "zh.wikisource.org,en.wikisource.org,gutendex.com,www.gutenberg.org,gutenberg.org,cn.bing.com,www.baidu.com,www.sogou.com"}
}
